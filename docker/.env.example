# Copy to docker/.env and fill in what you have. Only the providers you use need keys.
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Any string; clients must send it as the API key. Leave empty for no auth on localhost.
LITELLM_MASTER_KEY=sk-deskfish-local
# Optional: protect the desktop daemon + VNC websocket. Put the same value in deskfish.desktop.token.
DESKFISH_DESKTOP_TOKEN=
# Optional: VNC password (noVNC / the desktop pane will need it — deskfish.desktop.vncPassword).
DESKFISH_VNC_PASSWORD=
